   "id": "gp6-01",
   "title": "ベトナム語の文字（29字＋記号）",
   "pattern": "a ă â b c d đ e ê g h i k l m n o ô ơ p q r s t u ư v x y",
   "explain": "ベトナム語はアルファベットを使います。英語にない文字（ă・â・đ・ê・ô・ơ・ư）があり、đ は「ダ行」、d は北部では「ザ行」の音です。f・j・w・z は使いません。",
   "examples": [
    {
     "vi": "đi",
     "ja": "「行く」。đ は日本語の「ダ」に近い音。"
    },
    {
     "vi": "da",
     "ja": "「肌」。d は北部では「ザ」に近い音。"
    }
   ],
   "quiz": [
    {
     "q": "「行く」は ___i と書きます。",
     "choices": [
      "đ",
      "z",
      "j",
      "d"
     ],
     "answer": 0,
     "ja": "đi＝行く",
     "explain": "đ（横棒つき）が「ダ」の音です。"
    },
    {
     "q": "ベトナム語で使わない文字はどれですか？",
     "choices": [
      "ư",
      "ơ",
      "đ",
      "f"
     ],
     "answer": 3,
     "ja": "",
     "explain": "f・j・w・z はベトナム語では使いません。"
    }
   ]
  },
